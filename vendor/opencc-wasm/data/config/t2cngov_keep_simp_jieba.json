          {
            "type": "ocd2",
            "file": "cngov/TGPhrases.ocd2"
          },
          {
            "type": "ocd2",
            "file": "cngov/TGCharacters_keep_simp.ocd2"
          }
        ]
      }
    }
  ]
}
