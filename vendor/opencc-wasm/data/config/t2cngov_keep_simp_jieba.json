      "dict": {
        "type": "ocd2",
        "file": "CJK_Compatibility_Ideographs.ocd2"
      }
    }
  ],
  "segmentation": {
    "type": "jieba",
    "resources": {
      "dict_path": "jieba_dict/jieba.dict.utf8",
