{
  "name": "epub-convert",
  "private": true,
  "version": "1.0.0",
  "description": "Converting EPUB files between Traditional and Simplified Chinese, locally in the browser.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test:converter": "node --test tests/epub-converter.test.mjs",
    "test:dictionaries": "node --test tests/custom-dictionaries.test.mjs",
    "test:i18n": "node --test tests/i18n.test.mjs",
    "test:ui-template": "node tests/validate-ui-template.cjs",
    "vendor:update": "node scripts/update-vendor.mjs",
    "vendor:check": "node scripts/update-vendor.mjs --check"
  },
  "devDependencies": {
    "@zip.js/zip.js": "2.8.60",
    "opencc-wasm": "0.13.1",
    "tocas": "5.0.3",
    "vue": "3.5.42"
  }
}
